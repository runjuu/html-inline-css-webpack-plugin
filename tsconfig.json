{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build/",
    "declaration": true,
    "target": "es2015",
    "module": "Node16",
    "sourceMap": true,
    "lib": ["dom", "esnext"],
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Node16",
    "noEmitHelpers": true,
    "importHelpers": true,
    "strict": true,
    "noImplicitReturns": true
  },
  "exclude": [
    "node_modules",
    "build"
  ]
}
